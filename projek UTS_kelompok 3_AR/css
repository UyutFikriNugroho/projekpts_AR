*{
  margin:0;
  padding:0;
  box-sizing:border-box;
  font-family:Poppins;
}

body{
  height:100vh;
  background: radial-gradient(circle at top, #0f172a, #020617);
  overflow:hidden;
  color:white;
}

/* BACKGROUND GLOW */
body::before, body::after{
  content:'';
  position:absolute;
  width:500px;
  height:500px;
  filter:blur(180px);
  opacity:0.25;
  z-index:-1;
}

body::before{
  background:cyan;
  top:-100px;
  left:-100px;
}

body::after{
  background:blue;
  bottom:-100px;
  right:-100px;
}

/* NAVBAR */
nav{
  position:fixed;
  width:100%;
  padding:15px 30px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  backdrop-filter:blur(15px);
  background:rgba(255,255,255,0.05);
  border-bottom:1px solid rgba(255,255,255,0.1);
  z-index:10;
}

nav h2{
  color:cyan;
  letter-spacing:2px;
}

/* CONTAINER */
.container{
  height:100vh;
  display:flex;
  justify-content:center;
  align-items:center;
  padding:20px;
}

/* CARD */
.card{
  width:330px;
  padding:25px;
  border-radius:20px;
  background:rgba(255,255,255,0.05);
  backdrop-filter:blur(25px);
  box-shadow:0 0 50px rgba(0,255,255,0.2);
  text-align:center;
  border:1px solid rgba(255,255,255,0.1);
  animation:fadeUp 1s ease;
  position:relative;
  overflow:hidden;
}

/* SHINE EFFECT */
.card::before{
  content:'';
  position:absolute;
  width:200%;
  height:200%;
  background:linear-gradient(120deg, transparent, rgba(0,255,255,0.2), transparent);
  transform:rotate(25deg);
  animation:shine 6s linear infinite;
}

@keyframes shine{
  0%{ transform:translateX(-100%) rotate(25deg);}
  100%{ transform:translateX(100%) rotate(25deg);}
}

/* ANIMATION */
@keyframes fadeUp{
  from{opacity:0; transform:translateY(40px);}
  to{opacity:1; transform:translateY(0);}
}

/* TITLE */
h1{
  font-size:26px;
}

.role{
  font-size:13px;
  opacity:0.7;
}

.typing{
  color:cyan;
  margin:12px 0 20px;
  font-size:14px;
}

/* IMAGE */
.preview{
  width:220px;
  border-radius:15px;
  margin-bottom:20px;
  transition:0.3s;
}

.preview:hover{
  transform:scale(1.07);
  box-shadow:0 0 25px cyan;
}

/* BUTTON */
button{
  padding:13px;
  border:none;
  border-radius:10px;
  background:linear-gradient(90deg, cyan, blue);
  color:white;
  cursor:pointer;
  width:100%;
  font-size:14px;
  transition:0.3s;
  position:relative;
  overflow:hidden;
}

button:hover{
  transform:translateY(-2px);
  box-shadow:0 0 20px cyan;
}

button::after{
  content:'';
  position:absolute;
  width:100%;
  height:100%;
  background:rgba(255,255,255,0.2);
  left:-100%;
  top:0;
  transition:0.5s;
}

button:hover::after{
  left:100%;
}

/* MEMBERS */
.members{
  display:flex;
  justify-content:center;
  gap:8px;
  margin-top:18px;
  flex-wrap:wrap;
}

.member{
  padding:6px 10px;
  background:rgba(255,255,255,0.08);
  border-radius:6px;
  font-size:11px;
  transition:0.3s;
}

.member:hover{
  background:cyan;
  color:black;
}

/* FOOTER */
.social{
  margin-top:15px;
  font-size:12px;
  opacity:0.6;
}

/* PLANET BESAR */
.planet{
  position:absolute;
  width:180px;
  height:180px;
  border-radius:50%;
  background:radial-gradient(circle at 30% 30%, #22d3ee, #1e3a8a);
  top:10%;
  left:5%;
  box-shadow:0 0 60px cyan;
  animation:float 6s ease-in-out infinite;
}

/* RING */
.planet::after{
  content:'';
  position:absolute;
  width:240px;
  height:50px;
  border:2px solid rgba(0,255,255,0.4);
  border-radius:50%;
  top:50%;
  left:-30px;
  transform:rotate(20deg);
}

/* PLANET KECIL */
.planet.small{
  width:90px;
  height:90px;
  top:75%;
  left:80%;
  background:radial-gradient(circle, #60a5fa, #020617);
}

/* FLOAT */
@keyframes float{
  0%,100%{ transform:translateY(0);}
  50%{ transform:translateY(-20px);}
}

/* PARTICLE CANVAS */
canvas{
  position:absolute;
  z-index:-2;
}

/* RESPONSIVE */
@media(max-width:400px){
  .card{
    width:95%;
  }
}
.member{
  padding:8px 14px;
  background:rgba(255,255,255,0.08);
  border:none;
  border-radius:8px;
  font-size:13px;
  color:white;
  cursor:pointer;
  transition:0.3s;
}

/* HOVER */
.member:hover{
  background:rgba(0,255,255,0.2);
}

/* ACTIVE */
.member.active{
  background:linear-gradient(90deg, cyan, blue);
  box-shadow:0 0 15px cyan;
}
button:first-of-type{
  animation:pulse 2s infinite;
}

@keyframes pulse{
  0%{ box-shadow:0 0 0 0 rgba(0,255,255,0.6);}
  70%{ box-shadow:0 0 0 15px rgba(0,255,255,0);}
  100%{ box-shadow:0 0 0 0 rgba(0,255,255,0);}
}
.card{
  transition:0.4s;
}

.card:hover{
  transform:rotateX(5deg) rotateY(5deg) scale(1.03);
}